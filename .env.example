# ======================================================================
# Sem .env o sistema roda em modo demonstração. Copie este arquivo
# apenas quando for para produção.
# ======================================================================

ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ---------- Banco ----------
# SQLite (padrão):  sqlite+aiosqlite:///./vigia.db
DATABASE_URL=postgresql+asyncpg://vigia:vigia@localhost:5432/vigia

# ---------- Eventos ----------
# Vazio = barramento em memória (um processo só).
REDIS_URL=redis://localhost:6379/0
EVENT_CHANNEL=deteccoes.v1

# ---------- Simulador ----------
# SEMPRE false em produção.
SIMULADOR=false

# ---------- Segurança ----------
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
PASSWORD_EXPIRE_DAYS=90
OTP_TTL_SECONDS=600

# ---------- Biometria ----------
FACE_MODEL=buffalo_l
FACE_THRESHOLD=0.88
OBJECT_MODEL=yolov8l.pt
OBJECT_THRESHOLD=0.65
DEVICE=cuda

# ---------- Privacidade ----------
RETENTION_DAYS_UNMATCHED=90
MASK_PII_FOR_ROLES=OPERADOR,ANALISTA

# ---------- Gateway de mídia ----------
MEDIA_GATEWAY=http://localhost:8889

# ---------- ONVIF (PTZ) ----------
ONVIF_USER=admin
ONVIF_PASS=
