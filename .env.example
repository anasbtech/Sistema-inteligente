# ======================================================================
# Sem .env o sistema roda em modo demonstração. Copie este arquivo
# apenas quando for para produção.
# ======================================================================

ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Endereço por onde as pessoas CHEGAM — não onde o servidor escuta.
#
# É o que vai no link de redefinição de senha enviado por e-mail. Sem isto,
# o link sai como http://localhost:8000/... e, na caixa de entrada de quem
# recebeu, `localhost` é a máquina dela: o e-mail chega e o link não abre.
# Use o IP da rede, o nome do host ou o endereço do proxy.
APP_URL=https://seguranca.exemplo.gov.br

# ---------- Banco ----------
# SQLite (padrão):  sqlite+aiosqlite:///./seguranca.db
DATABASE_URL=postgresql+asyncpg://seguranca:seguranca@localhost:5432/seguranca

# ---------- Eventos ----------
# Vazio = barramento em memória (um processo só).
REDIS_URL=redis://localhost:6379/0
EVENT_CHANNEL=deteccoes.v1

# ---------- Simulador ----------
# SEMPRE false em produção.
SIMULADOR=false

# ---------- Segurança ----------
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
PASSWORD_EXPIRE_DAYS=90
OTP_TTL_SECONDS=600

# ---------- Biometria ----------
FACE_MODEL=buffalo_l
FACE_THRESHOLD=0.88
OBJECT_MODEL=yolov8l.pt
OBJECT_THRESHOLD=0.65
DEVICE=cuda

# ---------- Privacidade ----------
RETENTION_DAYS_UNMATCHED=90
MASK_PII_FOR_ROLES=OPERADOR,ANALISTA

# ---------- Gateway de mídia ----------
MEDIA_GATEWAY=http://localhost:8889

# ---------- ONVIF (PTZ) ----------
ONVIF_USER=admin
ONVIF_PASS=


# ---------- Envio de e-mail (código de recuperação de senha) ----------
# Sem SMTP_HOST o código só vai para o log, e ninguém recebe nada.
# Gmail: ative a verificação em duas etapas e gere uma "senha de app" em
# myaccount.google.com/apppasswords — a senha da conta é recusada.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=voce@gmail.com
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NOME=SEGURANÇA
SMTP_STARTTLS=true
